th:r=100,height:c=100,baseUrl:u}=e,d=(0,o.u)(e,l),{urls:{cdn:p}}=(0,i.B)();return(0,s.jsx)(a.E,(0,n.y)({src:`${null==u?p:u}/pwa/assets/branding/${t}`,alt:t,width:r,height:c,disabledFallback:!0,disabledPlaceholder:!0},d))}},56517:e=>{"use strict";e.exports=JSON.parse('{"termsAndConditions":"شرایط و قوانین","snappfoodTermsOfUseAndPrivacy":"شرایط استفاده از اسنپ‌فود و حریم خصوصی","definitionsAndTerms":{"title":"تعاریف و اصطلاحات","description":"اصطلاحاتی که در این شرایط و قوانین به کار رفته است دارای معانی مشروح زیر است:","item-company":"شرکت: شرکت مدرن سامانه غذا رسان اطلس که نسبت به ارائه خدمات اسنپ فود اقدام می‌کند","item-snappfood":"اسنپ فود: نام تجاری شرکت مدرن سامانه غذا رسان اطلس و مالک اپلیکیشن اسنپ فود که رابط بین کاربر سفارش دهنده، تامین کننده و پیک می‌باشد و خدمات نرم‌افزاری که توسط شرکت به منظور ارسال محصولات غذایی به کاربران ارائه می‌شود.","item-application":"اپلیکیشن: نرم افزار تحت وب اسنپ فود قابل اجرا در مرورگرهای اینترنتی و قابل نصب و اجرا در گوشی های تلفن همراه هوشمند","item-account":"حساب کاربری: حسابی است که اشخاص برای استفاده از خدمات اسنپ فود در اپلیکیشن ایجاد کرده‌اند.","item-orderer":"سفارش دهنده: شخص حقیقی یا حقوقی است که به منظور سفارش و دریافت اقلام ارائه شده توسط تامین کننده از اپلیکیشن اسنپ فود استفاده می‌نماید.","item-voucher":"کد تخفیف: کدی است که توسط اسنپ فود  صادر و تامین اعتبار شده است  و سفارش دهنده می تواند با وارد کردن آن در سامانه ی اسنپ فود از پرداخت کل یا قسمتی از هزینه خرید معاف شود.","item-cookie":"کوکی: فایلی است که به درخواست یک سایت، توسط مرورگر ایجاد می‌شود و امکان ذخیره اطلاعات بازدید و مناسب‌سازی آنها را فراهم می‌نماید."},"storedInformationInSnappfood":{"title":"اطلاعات کاربران چگونه و چرا در اسنپ فود نگهداری می شود؟","description":"سفارش دهندگان، اسنپ فود، اطلاعاتی را به صورت مستقیم در فرایند ثبت نام یا ایجاد حساب کاربری ثبت می کنند. همچنین اطلاعاتی به تناسب نوع سرویس مورد استفاده، تماس با پشتیبانی، ثبت سفارش و استفاده از راهکارها و قابلیتهای درون برنامه ثبت می شوند. برخی از اطلاعات به فراخور استفاده از اپلیکیشن ایجاد میشوند. برخی از اطلاعات نیز از دستگاه تلفن همراه و ارائه دهندگان اینترنت جمع آوری میشوند. جزییات این اطلاعات در ادامه ذکر شده است:","item-whenUserSignUp":{"title":"هنگام ثبت نام در سایت یا اپلیکیشن","description":"نام و نام خانوادگی، شماره تلفن همراه، آدرس ایمیل، آدرس، جنسیت و تاریح تولد در هنگام ثبت نام دریافت می‌شود. در این بخش فقط درج نام و نام خانوادگی و شماره تلفن همراه جهت احراز هویت سفارش دهنده، ارتباط پیک و تامین کننده با مشتری و ارسال کدهای تخفیف و پیشنهادات ویژه الزامی است."},"item-whenUserPlaceOrder":{"title":"هنگام ثبت سفارش","item-orderDetail":{"title":"جزئیات سفارش","description":"جزئیات سفارش شامل سفارش دهنده اقلام خریداری شده، توضیحات سفارش، قیمتها و فاکتور سفارش جهت حصول اطمینان از انطباق درخواست و اجناس تحویل شده و به عنوان سوابق فعالیت کاربران، ثبت و نگهداری می‌شود."},"item-ordererLocation":{"title":"اطلاعات مکانی سفارش دهنده","description":"آدرسهای تحویل سفارش که از سوی سفارش دهندگان ثبت می گردد جهت ارسال صحیح از اطلاعات الزامی بوده و جهت تسهیل سفارش های بعد ذخیره و نگهداری می شود. همچنین درصورت مجوزدهی کاربر در هنگام ورود به اپلیکیشن، موقعیت مکانی (GPS) از دستگاه فرد دریافت و نگهداری می‌شود."},"item-ordererTransaction":{"title":"تراکنش مالی سفارش دهنده","description":"هنگامی که کاربری اعتبار خود را افزایش میدهد یا هزینه سفارش خود را از طریق درگاه بانکی پرداخت می‌کند، کلیه سوابق مربوط به تراکنش و پیگیری بانکی ذخیره می‌شود. فرایند پرداخت و افزایش اعتبار از طریق درگاه های بانکی صورت میگیرد و اسنپ فود در فرآیند انتقال وجه و یا افزایش اعتبار هیچ دخالتی ندارد. تنها در صورت لغو سفارش و نیاز به بازگشت وجه شماره کارت بانکی سفارش دهنده را دریافت و در این راستا استفاده می‌کند."},"item-commentsAndReviews":{"title":"نظرات و امتیازات","description":"هنگام ثبت بازخورد و امتیازدهی به سفارش، تمام اطلاعات بازخورد و امتیاز برای پیگیری بیشتر و بهبود عملکرد تامین کنندگان و پیکها جمع‌آوری می‌شود."},"item-deviceInfo":{"title":"اطلاعات دستگاه تلفن همراه","description":"هنگام باز کردن اپلیکیشن و استفاده از خدمات اسنپ فود، اطلاعات دستگاه شامل مدل دستگاه، سیستم‌عامل و نسخه آن، آدرس IP، نوع مرورگر و نسخه اپلیکیشن بکارگرفته شده به‌ازای هر درخواست به منظور بهینه سازی خدمات و برطرف‌سازی مشکلات سرویس دهی در راستای بهبود تجربه مشتری ذخیره می‌شود. همچنین هنگام استفاده از اپلیکیشن اطلاعات کاربر توسط کوکی ها جمع آوری و در دستگاه کاربر ذخیره می شود."},"item-behavioralData":{"title":"داده های رفتاری","description":"به منظور توسعه بازار و بهبود اپلیکیشن در راستای نیازهای مشتریان، داده های رفتاری کاربران جمع‌آوری و ذخیره‌ می گردد. لازم به ذکر است این اطلاعات عمدتا به نحوی مورد استفاده قرار می‌گیرند که به طور مستقیم به یک شخص حقیقی مشخص و معین مرتبط نیستند."},"item-supportingContact":{"title":"برقراری ارتباط با پشتیبانی","description":"هنگام برقراری تماس (تلفنی یا درونبرنامه‌ای) با پشتیبانی، کلیه اطلاعات ارائه‌شده از فرد تماس گیرنده برای پیگیری و پاسخ‌دهی ثبت و نگهداری میشود. همچنین کلیه مکالمات صوتی صورت‎گرفته با مرکز تماس جهت بهبود عملکرد امور مشتریان نگهداری میشود.\\nلازم به ذکر است پایگاه اینترنتی اسنپ فود به آدرسhttps://snappfood.ir/  و اپلیکیشن اسنپ فود و زیردامنه های متصل به این نام دامنه می باشد و اسنپ فود فقط از همین طریق و شماره تماس های پشتیبانی مذکور در وب سایت با کاربران ارتباط برقرار می کند. شرکت هرگونه مکاتبات اینترنتی، تماس و یا پیامک از طرق ‌دیگر به‌جز آدرس‌های رسمی و معتبر مذکور را تأیید نمی‌کند."}}},"userRights":{"title":"حقوق کاربران در خصوص اطلاعات ارائه شده","description":"اسنپ فود اطلاعات هویتی کاربران را محرمانه می‌داند و با استفاده از دانش روز، روش‌های مناسب مدیریت داده‌ها و ارتقای بلوغ امنیت اطلاعات حداکثر تلاش خود را به عمل می‌آورد که اطلاعات کاربران را محافظت و از دسترسی‌های غیرقانونی جلوگیری کند. همچنین شرکت متعهد می شود هرگونه تغییر در دریافت اطلاعات شخصی کاربران را از طریق شرایط و قوانین اپلیکیشن در اسرع وقت به اطلاع کاربران می رساند.\\nبا این وجود کاربران می توانند در هر زمان اقدام به تغییر و یا حذف اطلاعات حساب کاربری خود نمایند. قابلیتهای ویرایش و حذف اطلاعات به شرح زیر است:","item-orderer":{"title":"سفارش دهنده","item-editOrChangeInfo":{"title":"ویرایش و تغییر اطلاعات","description":"سفارش دهندگان با مراجعه به پروفایل کاربری خود می توانند نام و نام خانوادگی خود را ویرایش نمایند. همچنین می توانند با مراجعه به قسمت آدرسها، آدرس های ثبت شده غیر ضروری را حذف و ویرایش نمایند."},"item-deleteAcount":{"title":"حذف حساب کاربری","description":"سفارش دهندگان می‌توانند با مراجعه به بخش \xabحساب من\xbb، در قسمت \xabاطلاعات کاربری\xbb نسبت به \xabحذف حساب کاربری\xbb اقدام کنند.<br/>پیش از حذف حساب کاربری، لطفاً به موارد زیر توجه کنید: <br /> پس از حذف حساب، اطلاعات کاربری و سوابق شما غیرقابل بازگشت خواهد بود. <br /> موجودی \xabکیف پول اسنپ‌فود\xbb پس از حذف حساب صفر شده و قابل بازگشت نیست. بنابراین قبل از اقدام، موجودی کیف پول را برداشت کنید. <br /> موجودی سایر کیف‌پول‌ها (مانند \xabاسنپ پی\xbb ، \xab آسان پرداخت\xbb ، \xabی‌کارت\xbb و ...) بدون تغییر باقی می‌ماند و همچنان از طریق اپلیکیشن‌های مربوطه قابل استفاده و برداشت است. <br /> برخی اطلاعات کاربران که طبق قوانین باید برای مدت مشخصی نگهداری شوند، تا پایان دوره قانونی، نزد شرکت ذخیره خواهند ماند."}}},"responsibilitiesOfUsers":{"title":"مسئولیتهای کاربران","item-0":"کاربران با ثبت‌نام در اپلیکیشن اسنپ فود، و اعلام رضایت نسبت به شرایط و قوانین استفاده از خدمات، می‌پذیرند که شرایط و قوانین حاضر را به صورت کامل مطالعه کرده و آن را با اطلاع کامل از شرایط و معانی‌اش پذیرفته‌اند. این شرایط و قوانین ممکن است در طول زمان تغییر کند که این تغییرات در همین صفحه منتشر و به روز رسانی می شود و از این طریق به اطلاع کاربران خواهد رسید و در صورت اعلام رضایت ایشان از این قوانین، امکان استفاده از سایت و اپلیکیشن اسنپ فود فراهم خواهد بود.","item-1":"کلیه اصول و رویه‏‌های شرکت منطبق با قوانین جمهوری اسلامی ایران است و کاربران می بایست هنگام استفاده از خدمات سایت یا اپلیکیشن، کلیه  قوانین و مقررات جمهوری اسلامی ایران اعم از قوانین جزایی، مدنی، مالی، تجاری و به طور خاص قانون تجارت الکترونیک، قانون جرائم رایانه‌ای ، قانون حمایت از حقوق مولفان و مصنفان، قانون ثبت اختراعات، طرحهای صنعتی و علائم تجاری، قانون حمایت از حقوق پدید آورندگان نرم افزارهای رایانه ای و سایر قوانین مرتبط  و مقررات این سایت را رعایت نمایند.","item-2":"برای استفاده از خدمات اسنپ فود لازم است که هر کاربر یک حساب کاربری در اپلیکیشن بسازد. تنها اشخاصی که بیش از ۱۸ سال سن دارند و واجد اهلیت قانونی هستند می‌توانند اقدام به ساخت حساب کاربری در اپلیکیشن کنند.","item-3":"کاربران متعهد می شوند که از ربات و نرم‌افزارهای مرتبط یا واسط برای کار با اپلیکیشن اعم از احراز هویت، تکمیل اطلاعات، ارسال درخواست و غیره استفاده نمی کنند.","item-4":"کاربران می‌پذیرند کلیه اطلاعات درخواستی اپلیکیشن را مطابق با واقعیت، صحیح و به‌‌روز وارد کنند و شخص کاربر مسئول ورود اطلاعات ناقص و یا نادرست می باشد. همچنین کاربر متعهد می‌شود هرگونه تغییر در مشخصات فردی خود را در اسرع وقت در اپلیکیشن اصلاح نماید. شرکت هیچ گونه مسئولیتی در مورد خسارات و مشکلات ناشی از عدم اعتبار اطلاعات اعلامی بر عهده نخواهد داشت.","item-5":"کاربران متعهد می‌شوند که صرفا با شماره همراه متعلق به خود در اپلیکیشن ثبت‌نام کنند. در غیر این صورت در برابر شخص ذی‌نفع صاحب شماره همراه تماما مسئول بوده و شرکت به محض آگاهی از این موضوع مجاز خواهد بود نسبت به لغو عضویت و حساب کاربری اقدام کند.","item-6":"مسئولیت همۀ فعالیت‌هایی که از طریق حساب کاربری اشخاص کاربر در اپلیکیشن یا سایر خدمات ارائه شده در اپلیکیشن اسنپ فود انجام می‌شود، به عهدۀ کاربران است. بنابراین مسئولیت اشخاص ثالث یا افرادی غیر از کاربر که با آن حساب از خدمات اپلیکیشن استفاده می‌کنند، تماما متوجه کاربر صاحب‌حساب است.","item-7":"در صورت مفقود شدن یا به سرقت رفتن اطلاعات حساب کاربری و گوشی موبایل، کاربر مذکور موظف است در اسرع وقت موضوع را به اطلاع شرکت برساند. بدیهی است تا زمانی که اطلاع‌رسانی به شرکت انجام نشده است، مسئولیت همۀ فعالیت‌هایی که از طریق حساب کاربری مذکور و موبایل کاربر انجام شده و می‌شود به عهدۀ وی خواهد بود.","item-8":"در صورت نقض مقررات از سوی هر کاربر یا ایجاد اختلال یا مشکل در عملکرد وب سایت یا اپلیکیشن و یا لطمه به حقوق سایرین بنابر دستور مقامات قضایی یا قانونی صالح و یا حسب صلاحدید، شرکت می تواند استفاده از خدمات و حساب کاربری کاربر را محدود یا ممنوع نموده یا به تعلیق درآورد و یا آن را مسدود نماید، اما مسئولیتی دیگر در قبال کاربران و کسب و کارهای خصوصی و عمومی نخواهد داشت و عواقب احتمالی تخلف، بر عهده کاربر خواهد بود و شرکت می تواند مراتب را به مراجع ذی صلاح اعلام نماید","item-9":"در صورت لغو بی‌دلیل و به کرات سفارش ثبت شده توسط کاربر، شرکت می‌تواند نسبت به غیرفعال کردن حساب کاربری آنها به صورت موقت یا دائم اقدام کند.","item-10":"در صورت بروز هرگونه اخلال در شبکه بانکی به هنگام پرداخت، اگر از حساب کاربر مبلغی کسر شود، این مبلغ ظرف مدت قانونی از طرف بانک بازگردانده می‌شود و شرکت در این مورد مسئولیتی ندارد.","item-11":"هرگونه اقدامی از سوی کاربران که منجر به ورود خسارت به شهرت، اعتبار و دارایی‌های شرکت شود. شرکت این حق را برای خود محفوظ می‌داند که حساب کاربر متخلف را مسدود کند و در صورت نیاز اقدامات قانونی لازم را علیه متخلف به‌عمل آورد و خسارت و حقوق قانونی خود را مطالبه کند.","item-12":"کاربر متعهد است هیچ فعالیتی در راستای حصول دسترسی غیرقانونی و غیرمتداول به هیچ بخش از اپلیکیشن اسنپ فود، انجام ندهد و از اقدام به هرگونه عملی که به طور مستقیم یا غیر مستقیم منجر به دسترسی غیرمجاز یا سوءاستفاده از اطلاعات موجود در اپلیکیشن یا اختلال در عملکرد اپلیکیشن گردد خودداری نماید.","item-13":"کاربران متعهد می‌شوند پس از اتمام استفاده از خدمات ارائه شده در اپلیکیشن، از اطلاعاتی که در نتیجۀ استفاده از خدمات اسنپ فود کسب کرده‌اند، هیچ‌گونه استفاده‌ای نکنند. طبعاً ذخیره کردن اطلاعات کاربران در دستگاه تلفن همراه یا به هر شیوۀ دیگر مغایر با قوانین اسنپ و سوپر اپ اسنپ است. همچنین کاربران متعهد می‌شوند در طول زمان استفاده از خدمات و اپلیکیشن اسنپ فود ، فقط در شرایط ضروری و به میزان مورد نیاز از اطلاعاتی که از کاربران ارائه شده است، استفاده کنند. استفادۀ کاربران از این اطلاعات باید مطابق با عرف جامعه و قوانین جمهوری اسلامی ایران باشد. در هر صورت اطلاعات مذکور به صورت امانت در اختیار کاربران قرار گرفته است و در صورت نقض تعهدات مذکور، شرکت و شخص ذینفع مجاز به پیگیری حقوقی و کیفری موضوع خواهد بود.","item-14":"با استفاده از خدمات اسنپ فود، کاربران می‌پذیرند که در حین سفارش، اسنپ فود را وسیله‌ای برای تبلیغات و بازاریابی کالا و خدمات شخصی خود قرار ندهند و از هرگونه معرفی و عرضۀ محصولات و خدمات شخصی و یا متعلق به دیگران خودداری کنند.","item-15":"در بخش نظرات در اسنپ فود، هر کاربر مجاز است در چارچوب شرایط و قوانین سایت، نظرات خود را به اشتراک بگذارد و پس از بررسی و تایید کارشناسان، نظرش را در اپلیکیشن مشاهده کند. بدیهی است که اگر قوانین سایت در نظرات کاربری رعایت نشود، تایید نمی‌شوند و در نتیجه به نمایش درنمی‌آیند.","item-16":"اسنپ فود در قبال درستی یا نادرستی نظرات منتشر شده در این قسمت، هیچ‌گونه مسئولیتی ندارد. نمایش نظرات کاربران در سایت به‌هیچ‌وجه به معنی تایید فنی اسنپ فود درباره‌ی محتویات نظر نیست؛ لذا از کاربران محترم تقاضا می‌شود، نظرات را اصل و پایه‌ی انتخاب و تصمیم‌گیری خود قرار ندهند.","item-17":"در هنگام درج نظرات، کاربران بایستی از کیبورد فارسی استفاده نمایند و از کشیدن حروف یا کلمات، استفاده بیش از حد معمول از فضای خالی (Space) ، استفاده‌ی مکرر از یک حرف یا کلمه، شکلک و اموجی در متن خودداری نمایند.","item-18":"برای نظر یا نقد و بررسی بهتر است عنوانی متناسب با متن انتخاب شود. نقد مناسب، نقدی است که فقط معایب یا فقط مزایا را در نظر نگیرد؛ بلکه به‌طور واقع‌بینانه معایب و مزایای هر سفارش را در کنار هم بررسی کند بنابراین جهت احترام‌گذاشتن به وقت دیگر کاربران، لازم است هنگام نوشتن نقد، مطالب غیرضروری را حذف کرده و فقط مطالب ضروری و مفید را لحاظ نمایند.","item-19":"تمام کاربران حق دارند نظرات خود را به شرط رعایت قوانین در سایت منتشر کنند؛ لذا حتی اگر نظری را به دور از واقعیت، جانب‌دارانه یا اشتباه یافتند، نباید نظر دهنده را مخاطب قرار دهند یا از وی انتقاد کنند. هر کاربر تنها می‌تواند نظر خود را عنوان کرده و قضاوت را به خوانندگان نظرات واگذار نماید.","item-20":"نظریاتی که شامل یکی از موارد زیر باشند، قابلیت نمایش در سامانه اسنپ فود را نخواهند داشت:","item-20-0":"شامل ادبیات غیر معیار باشند.","item-20-1":"نظرات شامل مشکلات بهداشتی که نیازمند بررسی و تماس با رستوران باشند","item-20-2":"نظرات شامل تبلیغ رستوران های دیگر","item-20-3":"نظرات بی ربط با رستوران و غذا","item-21":"شرکت می‌تواند برای حذف یا بازنشر محتواهای تولید و نشر شده توسط کاربر به‌  تشخیص خود اقدام نماید.","item-22":"اسنپ فود اطلاعات هویتی کاربران را محرمانه می‌داند و اطلاعات شخصی آنان را به هیچ شخص یا سازمان دیگری منتقل نمی‌کند، مگر آنکه در محدوده مورد نیاز برای ارائه خدمات و اجرای قرارداد و یا به موجب عمل به تعهدات قانونی و دستور مراجع ذی‌صلاح باشد. در این موارد هیچ گونه مسئولیت قانونی مبنی بر جبران خسارت برای شرکت وجود ندارد و کاربران با تایید این متن، آگاهی و اعلام رضایت خود از این موضوع را اعلام می دارند."},"acceptance":"کاربران می‌پذیرند و اعلام می‌کنند که کلیه موارد فوق الذکر را مطالعه کرده و مورد قبول ایشان است."}')},57046:(e,t,r)=>{"use strict";function n(e){return(n="function"==typeof Symbol&&"symbol"==typeof Symbol.iterator?function(e){return typeof e}:function(e){return e&&"function"==typeof Symbol&&e.constructor===Symbol&&e!==Symbol.prototype?"symbol":typeof e})(e)}function i(e,t){var r=Object.keys(e);if(Object.getOwnPropertySymbols){var n=Object.getOwnPropertySymbols(e);t&&(n=n.filter(function(t){return Object.getOwnPropertyDescriptor(e,t).enumerable})),r.push.apply(r,n)}return r}function o(e){for(var t=1;t<arguments.length;t++){var r=null==arguments[t]?{}:arguments[t];t%2?i(Object(r),!0).forEach(function(t){!function(e,t,r){var i;(i=function(e,t){if("object"!=n(e)||!e)return e;var r=e[Symbol.toPrimitive];if(void 0!==r){var i=r.call(e,t||"default");if("object"!=n(i))return i;throw TypeError("@@toPrimitive must return a primitive value.")}return("string"===t?String:Number)(e)}(t,"string"),(t="symbol"==n(i)?i:i+"")in e)?Object.defineProperty(e,t,{value:r,enumerable:!0,configurable:!0,writable:!0}):e[t]=r}(e,t,r[t])}):Object.getOwnPropertyDescriptors?Object.defineProperties(e,Object.getOwnPropertyDescriptors(r)):i(Object(r)).forEach(function(t){Object.defineProperty(e,t,Object.getOwnPropertyDescriptor(r,t))})}return e}r.d(t,{y:()=>o})},57862:(e,t,r)=>{"use strict";function n(e){if("u"<typeof window||null==window.navigator)return!1;let t=window.navigator.userAgentData?.brands;return Array.isArray(t)&&t.some(t=>e.test(t.brand))||e.test(window.navigator.userAgent)}function i(e){return"u">typeof window&&null!=window.navigator&&e.test(window.navigator.userAgentData?.platform||window.navigator.platform)}function o(e){let t=null;return()=>(null==t&&(t=e()),t)}r.d(t,{cX:()=>a,u