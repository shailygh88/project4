رح زیر اشاره نمود:","items-0":"تنوع بی‌نظیر غذاها اعم از ایرانی، سنتی، فرنگی، چینی، دریایی، ایتالیایی، مغولی، فست‌فود، گیاهی، رژیمی و ...","items-1":"روش‌های پرداخت متنوع (حضوری، اعتباری و آنلاین)","items-2":"روش‌های گوناگون جستجوی غذا بر اساس نوع رستوران، منطقه مورد نظر، غذای مورد علاقه و ...","items-3":"امکان اضافه نمودن رستوران‌های مورد علاقه در پروفایل شخصی افراد","items-4":"یکسان بودن قیمت منوها در سایت اسنپ‌فود با رستوران‌ها","items-5":"تخفیف بر روی غذاهای رستوران‌های مختلف","items-6":"شرکت در کمپین‌های اسنپ‌فود در مناسبت‌های مختلف","items-7":"اضافه كردن رستوران‌های جدید متناسب با نظرات كاربران","items-8":"مشاهده منوی به روز رستوران‌ها و عکس غذاها","items-9":"آگاهی از رستوران‌های جدید"},"contact":{"title":"تماس\xa0با\xa0اسنپ‌فود","description":"بی صبرانه منتظر شنیدن نظرات و پیشنهادهای شما هستیم.","callInfo":{"centralOfficePhone":"تلفن دفتر مرکزی","supportPhone":"تلفن پشتیبانی","supportPhoneDescription":"لطفاً جهت دریافت پشتیبانی سریع و آسان از پشتیبانی آنلاین استفاده کنید.","fax":"نمابر","faxDescription":"{{fax}} داخلی {{internal}}","email":"ایمیل","address":"آدرس","addressDescription":"تهران، بلوار میرداماد، پلاک ۳۶۵","zipCode":"کد پستی"},"comment":{"title":"ارسال نظر","name":"نام و نام خانوادگی","email":"ایمیل","cellPhone":"شماره تماس","whitchTeam":"تیم مورد نظر ","select":"انتخاب کنید","message":"متن پیام","captcha":"کد امنیتی","submit":"ارسال نظر","successfulSubmit":"با سپاس از همکاری شما، نظر شما توسط مدیر خدمات مشتریان اسنپ‌فود بررسی خواهد شد","teamOptions":{"SUPPORT":"مدیر مرکز تماس و پشتیبانی مشتریان","ACCOUNTING":"مدیر تیم قرارداد با رستوران‌ها","SALE":"مدیر تیم ارتباط با رستوران‌ها","PRODUCT":"مدیر محصول"},"errorMessage":{"name":"لطفا نام و نام خانوادگی را به درستی وارد نمایید.","email":"لطفا یک ایمیل معتبر وارد کنید.","cellPhone":"لطفاً یک شماره موبایل معتبر وارد کنید.","whitchTeam":"لطفا تیم مورد نظر را انتخاب نمایید.","message":"لطفا متن پیام را وارد نمایید.","captcha":"لطفا کد امنیتی را به درستی وارد نمایید."}},"social":{"title":"شبکه‌های اجتماعی","instagram":"اینستاگرام","telegram":"تلگرام","x":"ایکس","aparat":"آپارات","linkdin":"لینکدین"}},"favoriteVendors":{"title":"فروشگاه‌های مورد علاقه","emptyTitle":"فروشگاهی در لیست مورد علاقه‌های شما نیست","emptyDescription":"می‌توانید فروشگاه‌های نزدیک خود را ببینید و بعد از انتخاب، در صفحه فروشگاه آن را به لیست مورد علاقه‌ها اضافه کنید.","emptyAction":"مشاهده فروشگاه‌های نزدیک من"},"authentication":{"continue":"ادامه","accept":"تأیید","enterToAccount":"ورود به حساب","password":"رمز عبور","enterToUserAccount":"ورود به حساب کاربری","phoneNumber":"شماره موبایل","minLengthError":"{{field}} باید حداقل دارای {{length}} حرف باشد.","loginPassword":{"enterPassword":"رمز عبور خود را وارد کنید.","recoverPassword":"بازیابی رمز عبور","loginWithOTP":"ورود با کد یک‌بار مصرف","or":"یا"},"loginPhoneNumber":{"enterNumberToContinue":"برای ادامه، شماره موبایل خود را وارد کنید.","invalidPhoneError":"لطفاً یک شماره موبایل معتبر وارد کنید.","withLogin":"با ورود،","termsAndCondition":"شرایط و قوانین","accepted":"استفاده از اسنپ‌فود را می‌پذیرم."},"loginWithOTP":{"title":"تأیید شماره موبایل","codeSentTo":"کد ارسال شده به شماره","enterCode":"را وارد کنید.","requestCodeAgainUntil":"درخواست دوباره کد تا","sendSMSAgain":"ارسال دوباره پیامک","wrongCode":"کد تأیید وارد شده اشتباه است","codeSentSuccess":"کد ورود دوباره ارسال شد.","sendCodeWithCall":"ارسال کد با تماس تلفنی"},"passwordRecovery":{"title":"بازیابی رمز عبور","description":"رمز عبور جدید خود را وارد کنید","passwordRepeat":"تکرار رمز عبور","notSameError":"تکرار رمز عبور یکسان نیست.","submit":"ذخیره رمز جدید","timeIsOver":"زمان بازیابی رمز عبور تمام شده است. لطفا به صفحه قبل برگردید و دوباره تلاش کنید.","passwordCantBeTheSameAsOldPassword":"رمز عبور جدید با رمز فعلی شما نباید یکسان باشد."},"register":{"title":"ایجاد حساب کاربری","submit":"ایجاد حساب","description":"برای ایجاد حساب کاربری نام و نام‌خانوادگی خود را وارد کنید.","firstName":"نام","lastName":"نام خانوادگی"},"otpDisabled":{"title":"ارسال پیامک غیرفعال است","description":"امکان بازیابی رمز عبور به دلیل غیرفعال شدن ارسال پیامک توسط شما وجود ندارد. در‌صورتی‌که برای ورود به حساب با مشکلی روبه‌رو شده‌اید با پشتیبانی تماس بگیرید.","phone":"شماره تماس","call":"تماس  با پشتیبانی"}},"accountInfo":{"title":"اطلاعات کاربری","nameTitle":"نام","nameError":"ورود نام اجباری است.","lastNameTitle":"نام‌خانوادگی","lastNameError":"ورود نام‌خانوادگی اجباری است.","phoneTitle":"شماره موبایل","phoneHelpText":"امکان تغییر شماره موبایل وجود ندارد.","emailTitle":"ایمیل (اختیاری)","emailPlaceholder":"مثال: info@info.ir","emailError":"لطفاً یک ایمیل معتبر وارد کنید.","existingEmailError":"این ایمیل قبلا ثبت شده است.","submit":"ذخیره تغییرات","settingTitle":"تنظیمات ورود به حساب","recoverPass":"بازیابی یا تغییر رمز عبور","justPassTitle":"ورود به حساب‌ کاربری فقط با رمز عبور","justPassDescription":"ارسال کد‌ یک‌بارمصرف برای شما غیر‌فعال می‌شود.","submitSuccessMessage":"اطلاعات کاربری با موفقیت ذخیره شد."},"profile":{"easyPayment":"پرداخت سریع (با یک کلیک)","activateYourAccount":"حساب کاربری خود را فعال کنید","dailyDirectDebitLimit":"سقف مانده روزانه: {{price}} تومانء","transactionsAndWallte":"تراکنش‌ها و کیف پول","loginToYourAccount":"وارد حساب کاربری شوید","activateDirectDebit":"فعال‌سازی پرداخت مستقیم آپ","directDebit":"پرداخت مستقیم آپ","discountsAndBonuses":"تخفیف‌ها و جایزه‌ها","loginToAcount":"ورود به حساب کاربری","accountLogout":"خروج از حساب‌ کاربری","introductionStore":"معرفی فروشگاه","registerVendor":"ثبت‌نام فروشگاه","userInformation":"اطلاعات کاربری","inviteFriends":"دعوت از دوستان","specialTehran":"ویژه تهران","pointsBase":"امتیاز","points":"{{points}} امتیاز","pointsError":"خطا در دریافت امتیاز","directDebitError":"خطا در ارائه دهنده سرویس","favoriteVendors":"فروشگاه‌های مورد‌علاقه","logout":"خروج از حساب","snappClub":"اسنپ! کلاب","listOfAllWallets":"لیست همه کیف پول‌ها","myReviews":"نظرات من","support":"پشتیبانی","foodPro":"فودپرو","cancel":"انصراف","new":"جدید","loginDescription":"برای استفاده راحت‌تر و  امکان ثبت سفارش به حساب کاربری خود وارد شوید یا حساب کاربری ایجاد کنید.","logoutDescription":"با خروج از حساب‌کاربری امکان مشاهده اطلاعات کاربری و سفارش‌ها وجود ندارد و برای ثبت سفارش باید دوباره به حساب کاربری وارد شوید.","activeGiftCart":"فعال‌سازی کارت هدیه اسنپ‌فود"},"myReview":{"statusApproved":"تأیید شده","statusPending":"در حال بررسی","statusRejected":"تأیید نشده","emptyStateTitle":"شما نظری ثبت نکرده‌اید","emptyStateDescription":"با رفتن به لیست سفارش‌ها و ثبت نظر به کاربران دیگر در انتخاب فروشگاه باکیفیت کمک کنید.","emptyStateAction":"مشاهده لیست سفارش‌ها","restaurantTitle":"سفارش از {{vendorTitle}}","editReview":"ویرایش","deleteReview":"حذف","deleteReviewTitle":"حذف نظر","deleteReviewDescription":"آیا از حذف نظر خود مطمئن هستید؟","deleteReviewDiscard":"انصراف","deleteReviewConfirm":"حذف"},"accountSettings":{"loginOrRegister":"ورود / ثبت‌نام","continueAsGuest":"ادامه به عنوان مهمان","insertedWrongInput":"عبارت وارد شده صحیح نیست.","yourAccountWasDeleted":"حساب کاربری شما پاک شد","toContinueAfterAccountWasDeleted":"برای ادامه می‌توانید حساب کاربری جدید بسازید یا با حساب‌های دیگر وارد شوید.","recoverOrChangePassword":"بازیابی یا تغییر رمز عبور","deleteAccount":"حذف حساب کاربری","confirmAndDelete":"حذف حساب","delete":"حذف کردن","loginIntoAccountOnlyWithPassword":"ورود به حساب کاربری فقط با رمز عبور","otpWillDisabled":"ارسال کد‌ یک‌بارمصرف برای شما غیر‌فعال می‌شود.","onlyWithPasswordLogin":"ورود فقط با رمز عبور","confirmAndActive":"تأیید و فعال‌سازی","confirmAndDeactivate":"تأیید و غیرفعال‌سازی","DisableOtpHint":"برای غیر‌فعال‌سازی ورود با کد یک‌بارمصرف، رمز عبور را وارد کنید.","forgetYourPassword":"رمز عبور را فراموش کرده‌اید؟","passwordRecovery":"بازیابی رمز عبور","password":"رمز عبور","changePassword":"تغییر رمز عبور","typeYourNewPassword":"رمز عبور جدید خود را وارد کنید.","currentPassword":"رمز عبور فعلی","newPassword":"رمز عبور جدید","saveNewPassword":"ذخیره رمز جدید","passwordChanged":"رمز عبور با موفقیت تغییر یافت.","repetitivePassword":"رمز وارد شده تکراری است.","newPasswordRequirements":"رمز عبور جدید باید موارد زیر را داشته باشد.","passwordCantBeEmpty":"رمز عبور نمی‌تواند خالی باشد.","passwordRepeatCantBeEmpty":"تکرار رمز عبور نمی‌تواند خالی باشد.","deleteAcc":{"warnTitle":"توجه داشته باشید!","warn1":"با حذف حساب، موجودی کیف پول اسنپ‌فود غیرقابل‌دسترس و اطلاعات شما حذف می‌شود.","warn2":"با حذف حساب کاربری اسنپ‌فود، حساب کاربری شما در سایر بخش‌های سوپر اپ اسنپ (سرویس اعتباری، سوپر مارکت و ...) همچنان باقی می‌ماند.","instructionTitle":"در صورتی که قصد فروش یا واگذاری سیم‌کارت دارید:","instruction1":"حتما در سوپر اپ اسنپ شماره کاربری را تغییر بدهید؛ در غیر این صورت بخش‌های سرویس اعتباری، سوپرمارکت و... برای صاحب جدید سیم‌کارت در حساب اسنپ‌فود فعال می‌ماند.","instruction2":"با توجه به اتصال کیف پول آپ به شماره موبایل شما؛ برای جلوگیری از سواستفاده‌های احتمالی؛ از طریق اپلیکیشن آپ اقدام به برداشت موجودی کنید.","hint":"اگر از حذف حساب‌کاربری مطمئن هستید، کلمه <delete>{{deleteKeyword}}</delete> را در قسمت پایین بنویسید."}},"passwordComplexity":{"minLength":"حداقل {{length}} حرف انگلیسی","minNumber":"حداقل یک عدد","minSpecialCharacter":"حداقل یک کاراکتر خاص (مانند @ ! # $ + %)","minUpperCaseLetter":"حداقل یک حرف بزرگ انگلیسی","minLowerCaseLetter":"حداقل یک حرف کوچک انگلیسی"},"vouchers":{"vouchersAndGifts":"تخفیف‌ها و جایزه‌ها","vouchers":"تخفیف‌ها","giftCredits":"جایزه‌ها","cashbackTitle":"{{balance}} تومانء اعتبار جایزه خرید","cashbackDescription":"از {{vendor}}","cashbackExpiration":"قابل استفاده تا {{days}} روز دیگر","cashbackHourExpiration":"قابل استفاده تا {{hours}} ساعت دیگر","emptyVoucherTitle":"شما هیچ کد تخفیف فعالی‌ ندارید.","emptyVoucherAction":"مشاهده فروشگاه‌ها دارای تخفیف","emptyCashbackTitle":"شما هیچ جایزه‌ای ندارید.","emptyCashbackAction":"مشاهده فروشگاه‌های دارای جایزه"},"referUser":{"title":"سلام خوبی؟!","headline":"با دعوت دیگران جایزه بگیرید","description":"با دعوت دوستانتان از طریق لینک زیر {{referralAmount}} تومانء تخفیف بعد از اولین سفارششان دریافت کنید. همچنین {{referralAmount}} تومانء تخفیف جایزه ثبت‌نام برای دوستتان فرستاده می‌شود.","action":"انتشار لینک دعوت","referLinkCopy":"کپی لینک دعوت","share":"اشتراک گذاری","shareText":"سلام خوبی؟!\\n اگر تاحالا از اسنپفود سفارش ندادی؛ با استفاده از این لینک میتونی تخفیف {{referAmount}} هزار تومنی دریافت کنی.\\nپیشنهاد میکنم حتما امتحانش کنی\\n"},"refer":{"title":"ورود با کد دعوت","headline":"{{referAmount}} تومانء تخفیف اولین سفارش از اسنپ‌فود از طرف {{referrer}}","description":"{{referrer}} شما را به اسنپ‌فود دعوت کرده تا برای اولین سفارشتان از اسنپ‌فود {{referAmount}} تومانء تخفیف بگیرید. می‌توانید از نزدیک‌ترین رستوران‌ها، نانوایی‌ها، کافه‌ها، شیرینی‌فروشی‌ها و ... سفارش دهید.","action":"دریافت تخفیف"},"referralRedirect":{"successDescription":"کد تخفیف شما به‌زودی از طریق پیامک برایتان ارسال خواهد شد. برای مشاهده رستوران‌ها و فروشکاه‌های اطراف خود، روی دکمه زیر بزنید.","successAction":"برو به اسنپ‌فود","failDescription":"شما پیش از این عضو اسنپ‌فود شده‌اید. دریافت این کد تخفیف فقط برای کاربران جدید امکان‌پذیر است. شما می‌توانید برای دریافت کد تخفیف جدید دوستانتان را به اسنپ‌فود دعوت کنید تا با اولین سفارش آن‌ها، شما هم یک کد تخفیف دریافت کنید.","failMainAction":"دعوت از دوستان و دریافت تخفیف","failSecondAction":"خرید از اسنپ‌فود","dearUserWelcomeToSnappfood":"{{userFullName}} عزیز، به اسنپ‌فود خوش آمدید"},"badgeChat":"یک پیام جدید از پشتیبانی دارید.","badgeTicket":"وضعیت درخواست شما تغییر کرد.","introductionVendor":{"title":"معرفی فروشگاه","introduceYourVendor":"فروشگاه محبوبتان را به {{brandTitle}} معرفی کنید تا بعد از بررسی، آن را به لیست فروشگاه‌ها اضافه کنیم.","vendorName":"نام فروشگاه","vendorNamePlaceholder":"نام فروشگاه","vendorCity":"شهر فروشگاه","vendorAddress":"آدرس فروشگاه","vendorAddressPlaceholder":"آدرس فروشگاه حداقل دارای ۱۰ حرف باشد.","vendorNumber":"تلفن فروشگاه (با پیش‌‌شماره)","yourPhoneNumber":"شماره موبایل شما","yourFullName":"نام شما","yourEmail":"ایمیل شما","submitForm":"ارسال اطلاعات فروشگاه","pleaseInsertVendorName":"لطفا نام فروشگاه را وارد نمایید","pleaseInsertVendorCity":"لطفا شهر فروشگاه را وارد نمایید","pleaseInsertVendorAddress":"آدرس فروشگاه باید حداقل دارای ۱۰ حرف باشد.","pleaseInsertVendorPhone":"یک شماره تلفن معتبر وارد کنید.","pleaseInsertYourName":"لطفا نام کامل خود را وارد نمایید","pleaseInsertYourPhone":"یک شماره موبایل معتبر وارد کنید.","pleaseInsertYourEmail":"لطفاً یک ایمیل معتبر وارد کنید.","vendorFormError":"ارتباط با مشکل روبه‌رو شد.لطفا دوباره امتحان کنید.","submitVendorForm":"اطلاعات فروشگاه را دریافت کردیم و به‌زودی با آن‌ها تماس می‌گیریم. از شما بابت این معرفی سپاس‌گزاریم."},"directDebit":{"APDirectDebit":"پرداخت مستقیم آپ","APDirectDebitDescription":"با فعال‌سازی این خدمت، بدون نیاز به وارد کردن اطلاعات بانکی پرداخت‌های خود را به راحتی انجام دهید.","APDirectDebitAdvantages":"مزیت‌های فعال‌سازی پرداخت مستقیم","ContractingBanks":"بانک‌های طرف قرارداد","APDirectDebitAdvantagesDescription":{"item1":"پرداخت امن بدون نیاز به وارد کردن اطلاعات بانکی","item2":"شیوه جدید، پرداخت سریع و آسان","item3":"امکان تعیین سقف برداشت روزانه","item4":"امکان فعال‌سازی یا لغو خدمت در هر لحظه از طریق اپلیکیشن آپ"}},"dashboard":{"proOrders":"سفارش‌های پرو","totalBenefit":"مجموع سود پرو","benefitPrice":"{{price}} <tiny>تومانء</tiny>","remainingFoodProAccount":"<colored>{{days}} روز</colored> مانده تا پایان اشتراک پرو","totalMissing":"سود از دست رفته","missingTitle":"ارسال رایگان و تا {{maxPercent}}٪ تخفیف سفارش","freeTrialDesc":"دریافت عضویت رایگان {{days}} روزه "},"appVersion":"نسخه برنامه {{version}}","appIntroduction":{"pageTitle":"اپلیکیشن سفارش غذا (20 تا 40%تخفیف روزانه) | اسنپ فود","contentTitle":{"application":"اپلیکیشن","snappfood":"اسنپ‌فود","continues":"، اولین اپلیکیشن سفارش غذا"},"landing":{"pageTitle":"دانلود و نصب اپلیکیشن اسنپ فود برای اندروید و iOS با لینک مستقیم","pageDescription":"دانلود اپلیکیشن اسنپ فود برای اندروید (Android) و آیفون (iOS) با لینک مستقیم | خرید و سفارش آنلاین از بهترین رستوران‌ها و فروشگاه‌ها از طریق اپ اسنپ فود","title":"دانلود و نصب اپلیکیشن اسنپ فود","description":"در اپلیکیشن اسنپ‌فود شما می‌توانید به‌راحتی از نزدیک‌ترین رستوران‌ها و فروشگاه‌های اطراف خود انواع غذا و محصولات غذایی را آنلاین سفارش دهید و درب منزل تحویل بگیرید.","installIphone":"نصب روی آیفون","installIphoneDescription":"برای نصب اسنپ‌فود روی آیفون، روی یکی از استورهای زیر کلیک کنید:","installAndroid":"نصب روی اندروید","installAndroidDescription":"برای نصب اسنپ‌فود روی گوشی‌های اندرویدی، روی یکی از استورهای زیر کلیک کنید:","installWebApp":"نصب وب اپلیکیشن","application":"اپلیکیشن اسنپ‌فود","footer":"تجربه سفارش غذا از زودفود تا اسنپ‌فود","downloadWebapp":"دریافت وب اپلیکیشن","downloadFromSibApp":"دریافت از سیب‌اپ","downloadFromSibche":"دریافت از سیبچه","downloadFromIApps":"دریافت از آی‌اپس","downloadFromCafeBazar":"دریافت از بازار","downloadFromMyKet":"دریافت از مایکت","organic":"محصولات طبیعی","other":"سایر","snappfoodText":"<0>با اسنپ‌فود</0> برای خریدهای روزانه بیرون نرو!","iphoneVersion":"نسخه آیفون از","androidVersion":"نسخه اندروید از","sliderTitle_1":"ارسال سریع","sliderDescription_1":"کمتر از 30 دقیقه سفارشت رو دریافت کن!","sliderTitle_2":"5 درصد تخفیف همیشگی","sliderDescription_2":"با اشتراک فود پرو 5 درصد تخفیف بیشتر بگیر!","sliderTitle_3":"الان بخر بعدا پرداخت کن","sliderDescription_3":"اول ماه خرید کن، آخر ماه پرداخت کن!","sliderTitle_4":"تنوع بی‌نظیر فروشگاه‌ها","sliderDescription_4":"از هزاران فروشگاه متنوع اسنپ‌فود خرید کن!","sliderTitle_5":"پیگیری لحظه‌ای سفارش","sliderDescription_5":"از وضعیت لحظه‌ای سفارشت باخبر باش!"}},"nightFood":{"pageTitle":"رستوران و فست فود شبانه روزی تهران و سایر شهر‌ها","pageDescription":"سفارش آنلاین غذا از رستوران و فست فود شبانه روزی تهران و سایر شهر‌ها با امکان ارسال شبانه روزی درب منزل","imageAlt":"رستوران شبانه روزی","landing":{"title":"رستوران شبانه روزی؛ سفارش 24 ساعته غذا","description":"دیگر نگران ساعت نباشید؛ ما در اسنپ فود این فرصت را برای شما فراهم کرده‌ایم تا در هر ساعت از شب، با ثبت سفارش از رستوران شبانه روزی اسنپ فود، غذای دلخواه خود را تحویل بگیرید و نوش‌جان کنید. فرقی نمی‌کند اوایل صبح است یا نیمه‌شب؛ به‌راحتی می‌توانید از منوی فست‌فودها و رستوران‌های شبانه‌روزی، آیتم‌های مدنظر خود را انتخاب کنید. از نوشیدنی‌های مختلف گرفته تا سالادهای تازه و انواع غذاهای ایرانی و فرنگی، همه‌چیز در دسترس شماست."},"nightFoodInfo":{"title":"غذا شبانه روزی؛ در تهران و سایر شهرها","description":"فست فود شبانه روزی در کنار افرادی است که در شیفت‌های شبانه مشغول به کار هستند یا به دلایل مختلف، شب‌ها را برای انجام کار ترجیح می‌دهند. در ساعاتی از نیمه‌شب که سفارش یک وعده غذایی گرم و خوش‌طعم غیرممکن به‌نظر می‌رسد، ما به شما این امکان را می‌دهیم تا فست‌فودهای شبانه روزی نزدیک را مشاهده کنید و غذای خود را سفارش دهید. سفارش غذای باکیفیت از رستوران شبانه روزی تهران و دیگر شهرها بسیار ساده است. این رستوران‌ها معمولا منوی متنوعی از غذاهای ایرانی و بین‌المللی را ارائه می‌دهند که هر ذائقه‌ای را راضی می‌کند. فرقی ندارد که به کباب علاقه دارید یا طرفدار طعم‌‌های جدید غذاهای فرنگی هستید؛ شما با اسنپ فود می‌توانید در ظرف چند دقیقه غذای خود را از یک رستوران ۲۴ ساعته تهیه کنید."},"advantages":{"title":"مزایای سفارش شبانه روزی غذا از اسنپ فود","description":"ما در اسنپ فود تمام تلاشمان را می‌کنیم تا تجربه‌ای مثبت و خاطره‌انگیز از رستوران و فست فود شبانه داشته باشید. در ادامه می‌خوانید که سفارش از اسنپ فود به‌صورت شبانه‌روزی چه مزایایی دارد.","cardListData":{"title_1":"تحویل سریع","description_1":"ما درک می‌کنیم که انتظار برای تحویل غذا می‌تواند چقدر سخت باشد، اما مدت‌زمان تحویل سفارش‌ها به عوامل مختلفی بستگی دارد؛ از جمله زمان و فاصله رستوران تا محل مورد نظر شما. بااین‌حال، ما همواره در تلاش هستیم تا غذای شما را در سریع‌ترین زمان ممکن به دستتان برسانیم. البته توصیه ما این است که اگر خیلی عجله دارید، از جایی غذا سفارش دهید که به شما نزدیک‌تر است.","title_2":"پرداخت بدون معطلی","description_2":"پرداخت آنلاین، ثبت سفارش از رستوران‌ شبانه را به‌مراتب آسان‌تر کرده است. با این روش، شما هزینه سفارشتان را خیلی سریع پرداخت می‌کنید و دیگر دغدغه به‌همراه‌داشتن پول نقد یا دردسرهای پرداخت حضوری را نخواهید داشت.","title_3":"انتخاب بهترین رستوران شبانه روزی","description_3":"مزایای سفارش شبانه از اسنپ فود فراتر از صرفه‌جویی در زمان و راحتی است. با توجه به تعداد بالای کاربران و درخواست‌های فراوان برای سفارش آنلاین غذا از طریق اسنپ فود، شما می‌توانید با استفاده از سیستم نظرخواهی و بررسی امتیازهای ثبت‌شده، رستورانی‌ را انتخاب کنید که بیشترین امتیاز و نظرات مثبت را دارد. این ویژگی به شما این اطمینان را می‌دهد که رستوران ۲۴ ساعته مدنظرتان در سطح بالایی قرار دارد و می‌توانید با خیالی راحت سفارش دهید.","title_4":"روندی ساده و بی‌دردسر","description_4":"سفارش غذا در نیمه‌شب از اسنپ فود هیچ تفاوتی با ساعات روز ندارد و به‌سادگی انجام می‌شود. شما به‌راحتی از منوی رستوران،‌ گزینه‌های مدنظرتان را انتخاب کنید و مبلغ آن را بپردازید. در نهایت، کمی در شبکه‌های اجتماعی بگردید یا دقایقی از پادکست محبوبتان را گوش دهید تا غذای شما را در محل مورد نظر تحویل دهیم.","title_5":"منوی متنوع","description_5":"هیچ توجهی به عقربه‌های ساعت نداشته باشید؛ در هر موقعیتی، شما می‌توانید از انواع غذاهای سنتی و فرنگی، نوشیدنی‌های سرد و گرم و دسرهای اشتها برانگیز لذت ببرید. با یک جست‌وجوی ساده در منوی فست‌فود و رستوران شبانه روزی، آیتم مورد نظر خود را انتخاب کنید. سفارش شما با همان طعم و کیفیتی که همیشه انتظار دارید، به دستتان خواهد رسید.","title_6":"پشتیبانی ۲۴ ساعته","description_6":"تیم پشتیبانی ما به‌صورت شبانه‌روزی و در تمام روزهای هفته آماده پاسخگویی به شماست. اگر در روند ثبت سفارش با مشکلی مواجه شدید یا از خدمات ارائه‌شده ناراضی بودید، بدون این‌که به ساعت نگاه کنید، به ما اطلاع دهید تا مشکل شما را فورا پیگیری و رفع کنیم.","title_7":"تخفیف‌های جذاب","description_7":"سفارش غذا با تخفیف‌های ویژه اسنپ فود، حس بهتری به‌همراه خواهد داشت. اگر اولین سفارشتان به ما باشد، تخفیف ویژه سفارش اول به شما تعلق می‌گیرد؛ اما اگر از کاربران باسابقه ما باشید، این را بدانید که همیشه تخفیف‌های متنوعی برای شما داریم. بنابراین با سفارش آنلاین از طریق اپلیکیشن یا سایت اسنپ فود، غذای همیشگی خود را با قیمتی کم‌تر دریافت کنید."}},"availability":{"title":"اسنپ فود؛ همراه شما در هر ساعت از شبانه‌روز","description":"سفارش غذا از اسنپ فود دیگر محدود به ساعت‌های کاری نیست؛ هر ساعت که احساس گرسنگی به‌سراغتان آمد، فورا از رستوران یا فست فود شبانه روزی اطرافتان غذای دلخواه خود را سفارش دهید و در سریع‌ترین زمان ممکن، آن را تحویل بگیرید. ما تلاش می‌کنیم تا با پشتیبانی 24 ساعته و تحویل فوری، تجربه‌ای لذت‌بخش از سفارش غذا برایتان رقم بزنیم."},"faq":{"title":"سوالات متداول درباره کد تخفیف اسنپ فود","accordionData":{"title_1":"آیا امکان سفارش غذا از اسنپ فود در نیمه‌های شب وجود دارد؟","description_1":"بله؛ شما می‌توانید به‌صورت 24 ساعته از طریق سایت یا اپلیکیشن اسنپ فود، غذای مورد نظرتان را سفارش دهید.","title_2":"چه نوع غذاهایی را می‌توان از اسنپ فود سفارش داد؟","description_2":"امکان سفارش انواع غذاهای ایرانی و بین‌المللی از طریق اسنپ فود وجود دارد.","title_3":"آیا اسنپ فود پشتیبانی 24 ساعته هم دارد؟","description_3":"بله؛ از زمان ثبت سفارش تا تحویل غذا، پشتیبانی اسنپ فود لحظه‌به‌لحظه کنار شماست.","title_4":"سرویس سفارش غذای شبانه‌روزی در چه شهرهایی فعال است؟","description_4":"در هر شهری که سرویس اسنپ‌فود فعال باشد، امکان سفارش شبانه‌روزی غذا هم فراهم است."}}},"backToHomePage":"بازگشت به صفحه اصلی","referralDescription":"کد تخفیف شما بعد از ثبت‌نام فعال می‌شود؛ شما می‌توانید از این کد در رستوران و کافه استفاده کنید.","snappFoodSelectUser":"اسنپ‌فود؛ انتخاب ۲۰ میلیون ایرانی","referralStoreDescription":"بیش از ۵۰٬۰۰۰ رستوران، پروتئینی، قنادی، نانوایی و ...","referralBakeryDescription":"انتخاب بهتر با خواندن نظر واقعی مشتریان","referralDeliveryDescription":"ارسال سریع و آسان سفارش","showVoucherCode":"نمایش کد تخفیف","snappFoodDiscount":"تخفیف اسنپ‌فود","voucherReferralTitle":"{{price}} تومان تخفیف روی تمام سرویس‌ها ","voucherReferralDescription":"۱ بار قابل استفاده در {{day}} روز دیگر","voucherIsNotActivate":"کد تخفیف فعال نشد","serviceTemporarilyUnavailable":"این سرویس به‌طور موقت در دسترس نیست. لطفاً کمی بعد دوباره تلاش کنید.","voucherIsActive":"تخفیف {{voucher}} هزار تومانی فعال شد!","welcomeToSnappFood":"به اسنپ‌فود خوش آمدید!","from":"از طرف {{name}}","startOrder":"شروع سفارش","freeTrial":{"oneMonthReward":"شما {{freeDays}} روز ارسال <colored>رایگان</colored> هدیه گرفتید!","oneMonthFreeSubscription":"<demibold>{{name}} عزیز</demibold>، هدیه اختصاصی پرو، {{freeDays}} روز برای شما فعال شد.","maxDeliveryPrice":"<demibold>ارسال رایگان</demibold> تا سقف {{price}} تومانء در هر سفارش","proVendors":"هدیه شما در فروشگاه‌های پرو <logo></logo> فعال است","discountPercent":"تا {{maxPercent}} درصد <demibold>تخفیف</demibold> در هر سفارش","subscriptionBenefit":"با هر سفارش از این مزایا بهره‌مند می‌شوید.","freeSubscription":"از سود این هدیه لذت ببرید!","autoReward":"تخفیف‌ها به‌صورت خودکار اعمال می‌شود.","proVendorOnBoardDescribtion":"سود خرید شما از فروشگاه‌های پرو در بخش \xabحساب من\xbb قابل‌مشاهده است.","proVendorsOnBoardMessage":"تخفیف پشتِ تخفیف","subscriptionOnBoarding":"ارسال رایگان + تا ۲۰٪ تخفیف در هر سفارش","profitOnBoarding":"فروشگاه‌های پرو با علامت <logo></logo> ","profitOnBoardingContinue":"و درصد تخفیفشان نمایش داده می‌شوند.","next":"بعدی","oneMonthProTitle":"صرفه‌جویی میلیونی با پرو <logo></logo>","oneMonthProDescription":"شما کاربر پرو هستید. کاربران پرو به طور متوسط ۵ میلیون تومان ماهیانه در هزینه‌های خود صرفه جویی می‌کنند."},"rules":{"title":"شرایط و قوانین","description":"قوانین استفاده از خدمات سامانه اسنپ‌فود","items-0":"اسنپ‌فود تابع قوانین و مقررات جمهوری اسلامی ایران است و درج هرگونه موارد سیاسی، غیر اخلاقی و مغایر با هنجارهای اجتماعی باعث حذف حساب کاربر موردنظر خواهد شد.","items-1":"استفاده از نام و نام‌خانوادگی حقیقی افراد به منظور ثبت‌نام در سایت الزامی است. در صورت مشاهده کلمات رکیک و الفاظ نامناسب، حساب كاربر حذف خواهد شد.","items-2":"هنگام سفارش، ثبت یک شماره معتبر و قابل دسترس برای کاربران الزامی است.","items-3":"مسئولیت وارد کردن اطلاعات اشتباه و غیر واقعی از قبیل نام و نام‌خانوادگی، آدرس و شماره تماس به عهده کاربر است.","items-4":"در اسنپ‌فود همواره سعی کرده‌ایم، با بهترین و معتبرترین رستوران‌ها همکاری کنیم. ما در این زنجیره تنها نماینده‌ای برای برقراری ارتباط بهینه و موثر میان مشتریان و رستوران‌های سراسر ایران هستیم. اسنپ‌فود مسئولیتی در قبال کیفیت غذا و نحوه ارسال سفارش‌ها توسط رستوران‌ها عهده‌دار نیست اما همواره سعی کرده ایم با پیگیری و مذاکره با رستوران‌ها این مشکلات را به حداقل کاهش دهیم. البته در مورد سفارش‌های اکسپرس، تمام مسئولیت ارسال متوجه ماست و سعی در جبران هر گونه مشکل احتمالی خواهیم داشت.","items-5":"نشان تجاری اسنپ‌فود، در اداره کل ثبت شرکت‌ها و اداره کل مالکیت صنعتی به ثبت رسیده‌است و تحت پوشش قانون کپی‌رایت است.","items-6":"تمامی متن‌ها، طرح‌های گرافیکی و کدهای به کار گرفته شده در اسنپ‌فود جزو اموال شرکت \xabمدرن سامانه غذارسان اطلس\xbb محسوب شده و هرگونه کپی برداری، نشر، نمایش، بازسازی و انتقال آن به هر صورت بدون اجازه مالک ممنوع بوده و پیگرد قانونی در پی خواهد داشت.","items-7":"جهت استفاده از تخفیف در اسنپ‌فود ( تخفیفات منو رستوران ها، کدهای تخفیف، بسته های خدماتی، کمپین‌ها، کوپن‌ها و هرگونه خدماتی که در جهت کاهش مبلغ نهایی پرداخت است) باید روش پرداخت آنلاین و یا اعتباری انتخاب شود و این خدمات در روش پرداخت نقدی اعمال نمی‌شود."},"showProVendors":"مشاهده فروشگاه‌های پرو","withAnyRefer":"تخفیف اسنپ‌فود، با هر دعوت موفق","referYourFriends":"با ارسال لینک دعوت، دوست شما کد تخفیف {{refereeValue}} هزار تومانی هدیه می‌گیرد. بعد از ثبت سفارش اول، شما هم کد تخفیف {{refererValue}} هزار تومانی دریافت می‌کنید.","youDontHaveAnyRefer":"تعداد دعوت‌های شما به پایان رسیده است. به زودی می‌توانید مجدد دعوت کنید.","usedVoucher":"تعداد دعوت‌های استفاده شده","usedVoucherCount":"{{from}} از {{to}}","successRefer":"تخفیف از {{count}} دعوت موفق","referBannerDescription":"با گذشت ۶ ماه از ثبت‌نام و ثبت ۱۰ سفارش، امکان دعوت از دوستان برای شما فعال می‌شود.","givenVoucher":"تخفیف دریافت‌ شده","faq":{"title":"پرسش‌های پرتکرار","sections":{"order":{"title":"سفارش","items":[{"question":"چگونه سفارش ثبت کنم؟","answer":"جهت ثبت سفارش در سامانه اسنپ‌فود با انتخاب آدرس یا جست‌وجوی محله خود، لیست رستوران‌هایی که به شما سرویس می‌دهند را مشاهده می‌کنید. با توجه به اطلاعات ثبت شده در پروفایل هر رستوران، مشاهده منو و نظرات سایر کاربران می‌توانید انتخاب مناسبی داشته باشید. بعد از تکمیل سبد خرید، از شما خواسته می شود تا وارد حساب کاربری خود شوید یا حساب کاربری جدید بسازید. با انتخاب آدرس مورد نظر و انتخاب نحوه پرداخت (اگر کد تخفیف دارید در همین مرحله در قسمت کد تخفیف وارد و اعمال کنید) وارد درگاه بانکی مورد نظر شوید و مبلغ سفارش خود را پرداخت نمایید. با ثبت موفق سفارش، زمان انتظار برای تهیه و ارسال سفارش به شما نمایش داده می‌شود."},{"question":"چرا امکان ثبت سفارش نقدی برای من وجود ندارد؟","answer":"ممکن است که برخی از رستوران‌ها امکان پرداخت نقدی را در اسنپ‌فود نداشته باشند."}]},"discount":{"title":"کد تخفیف","items":[{"question":"از کجا کد تخفیف دریافت کنم؟","answer":"تخفیفات با توجه به کمپین‌های مختلف در اختیار مشتریان قرار می‌گیرد. هم‌چنین بسته‌های خدماتی جهت کاهش هزینه‌های سفارش‌های شما در سایت وجود دارد."},{"question":"چرا کد تخفیف اعمال نمی‌شود؟","answer":"در صورت اعمال کد تخفیف با توجه به پیغام نمایش داده شده توسط سیستم مشکل احتمالی از قبیل انقضای کد، اشتباه بودن کد، غیرقابل استفاده بودن کد برای این رستوران یا سفارش به شما گزارش می‌شود."},{"question":"کد تخفیف را کجا وارد کنم؟","answer":"بعد از تکمیل سبد خرید، انتخاب آدرس و انتخاب نحوه پرداخت آنلاین، کد تخفیف خود را داخل باکس کد تخفیف وارد کرده و از گزینه اعمال کد استفاده کنید و با استفاده از روش پرداخت آنلاین سفارش خود را تکمیل کنید. حتما به توضیحات کد تخفیف دریافت شده و شرایط استفاده از آن توجه کنید."},{"question":"کد تخفیف ارسالی را گم کرده ام. از کجا می‌توانم پیدا کنم؟","answer":"به دلیل متعدد بودن و تنوع کمپین‌ها و مجموعه‌هایی که برای ارائه این تخفیفات با مجموعه اسنپ‌فود همکاری می‌کنند، ارسال مجدد کدهای تخفیف ممکن نیست.\xa0"},{"question":"چرا کد تخفیف کمتر از مبلغ اعلام شده از سفارشم کسر کرد؟","answer":"کدهای تخفیف، درصد اعلام شده تا سقف خریدی که در توضیحات کد درج شده را از سفارش شما کسر می‌کنند. به عنوان مثال کد تخفیف ٪۲۵ تا سقف خرید ۲۰،۰۰۰ تومان، درصورتی که سبد خرید شما ۲۰،۰۰۰ تومان یا بیشتر از این مبلغ باشد نهایتا مبلغ ۵۰۰۰ تومان از سفارش شما را کسر می‌کند."},{"question":"در هر سفارش از چند کد تخفیف می‌توانم استفاده کنم؟","answer":"در هر سفارش فقط از یک کد تخفیف می‌شود استفاده کرد. اما اگر رستوران انتخابی شما تخفیف داشته باشد، این تخفیف‌ها با هم جمع می‌شوند."},{"question":"چرا تخفیف رستوران و یا کد تخفیف روی سفارش نقدی (پرداخت در محل) اعمال نشد؟","answer":"تمام تخفیف‌های مجموعه اسنپ‌فود فقط برای سفارش‌های پرداخت آنلاین است."}]},"area":{"title":"محدوده","items":[{"question":"چرا نمی‌توانم از رستورانی که قبلا ثبت سفارش ثبت کردم، سفارش ثبت کنم؟","answer":"درصورتی که موقعیت ثبت شده مکانی روی نقشه با آدرس ثبت شده مطابقت دارد و بازهم امکان ثبت سفارش از رستوران را ندارید، رستوران مد نظر شما محدوده سرویس‌دهی خود را تغییر داده و برای محدوده مورد نظر شما ارسال ندارد. با جست‌وجو رستوران‌های نزدیک‌تر و انتخاب رستوران دیگر می‌توانید سفارش خود را از اسنپ‌فود ثبت کنید."}]},"payment":{"title":"پرداخت","items":[{"question":"پرداخت آنلاین؟","answer":"برای پرداخت آنلاین در خریدهای اینترنتی احتیاج به کارت بانکی عضو سیستم شتاب و فعال بودن رمز اینترنتی (رمز دوم) این کارت دارید. بعد از ورود به حساب کاربری خود در اسنپ‌فود و تکمیل سبد خرید خود، با انتخاب نحوه پرداخت آنلاین و درگاه بانکی مورد نظر خود می‌توانید پرداخت را با وارد کردن اطلاعات مورد نیاز درگاه بانکی انجام دهید."},{"question":"تراکنش ناموفق چیست؟ و از چه طریق قابل پیگیری است؟","answer":"درصورتی که فرایند پرداخت آنلاین شما دچار مشکل شود و وجه کسر شده از حساب بانکی شما به سایت پذیرنده (اسنپ فود) منتقل نشود، یک تراکنش یا پرداخت ناموفق صورت گرفته است که این مبلغ کسر شده با بررسی توسط درگاه انتخاب شده به حساب شما برگشت می‌خورد. (این فرایند نهایتا ۷۲ ساعت کاری زمان می‌برد و درصورتی که بعد از گذشت این زمان، وجه به حساب شما برگشت داده نشد، می‌توانید با شماره تماسی که پشت کارت بانکی شما درج شده تماس بگیرید و این موضوع را بررسی کنید)"},{"question":"چرا بعد از ورود به درگاه مبلغ تخفیف درنظر گرفته نشد؟","answer":"درصورتی که بعد از اعمال و کسر شدن مبلغ تخفیف اقدام به تغییر سبد خرید نمایید و یا اینکه صفحه وب را بازیابی (refresh) نمایید، تخفیف اعمال شده هنگام ورود به درگاه بانکی برای شما لحاظ نمی‌شود."},{"question":"چرا اطلاعات بانکی من در درگاه پرداخت ثبت شده؟","answer":"ثبت مشخصات بانکی شما در درگاه پرداخت متصل به شماره همراه شماست و اطلاعات ضروری مانند رمز دوم و کد cvv۲ در این درگاه ثبت نمی‌شود. این کار توسط درگاه پرداخت (با مجوز بانک مرکزی) و فقط جهت سهولت و تسریع در پرداخت شما است و هیچ‌گونه خطر امنیتی برای پرداخت های شما ندارد."}]}}},"footer":{"aboutSnappfood":"درباره اسنپ‌فود","foodPro":"رستوران‌های پرو","foodProInfo":"با خرید اشتراک پرو به کاربر حرفه‌ای اسنپ‌فود تبدیل  می‌شوید و در هر سفارش ارسال رایگان و تا ۲۰٪ تخفیف را تجربه کنید. این اشتراک به مدت یک ماه فعال خواهد بود و محدودیتی در استفاده از آن ندارید.\\n","nightFood":"سفارش شبانه","installApp":"نصب اپ","contactUs":"تماس با ما","registrationOfComplaints":"ثبت شکایات","registrationOfSellers":"ثبت‌نام فروشندگان","careers":"فرصت‌های شغلی","description":"اسنپ‌فود، فرهنگ جدید سفارش غذاست که برای اولین بار در ایران معرفی و اجرا شده است. سفارش اینترنتی غذا در ايران تا قبل از راه‌اندازی اسنپ‌فود تنها یک رویا بود و کمتر کسی از مزایای آن خبر داشت.","cities":"اسنپ‌فود در شهر‌های ایران","faq":"پرسش‌های پرتکرار","rules":"شرایط و قوانین"}}')},12404:(e,t,r)=>{"use strict";r.d(t,{Mz:()=>o});var n="NOT_FOUND",i=function(e,t){return e===t},o=function(e){for(var t=arguments.length,r=Array(t>1?t-1:0),n=1;n<t;n++)r[n-1]=arguments[n];return function(){for(var t,n=arguments.length,i=Array(n),o=0;o<n;o++)i[o]=arguments[o];var a=0,s={memoizeOptions:void 0},l=i.pop();if("object"==typeof l&&(s=l,l=i.pop()),"function"!=typeof l)throw Error("createSelector expects an output function after the inputs, but received: ["+typeof l+"]");var c=s.memoizeOptions,u=void 0===c?r:c,d=Array.isArray(u)?u:[u],p=function(e){var t=Array.isArray(e[0])?e[0]:e;if(!t.every(function(e){return"function"==typeof e}))throw Error("createSelector expects all input-selectors to be functions, but received the following types: ["+t.map(function(e){return"function"==typeof e?"function "+(e.name||"unnamed")+"()":typeof e}).join(", ")+"]");return t}(i),f=e.apply(void 0,[function(){return a++,l.apply(null,arguments)}].concat(d)),h=e(function(){for(var e=[],r=p.length,n=0;n<r;n++)e.push(p[n].apply(null,arguments));return t=f.apply(null,e)});return Object.assign(h,{resultFunc:l,memoizedResultFunc:f,dependencies:p,lastResult:function(){return t},recomputations:function(){return a},resetRecomputations:function(){return 