questModal":{"title":"درخواست لغو سفارش","description":"نتیجه نهایی درخواست لغو سفارش پس از پیگیری پشتیبانی اسنپ‌فود به شما اطلاع داده می‌شود و لطفاً تا زمان اعلام نتیجه نهایی در آدرس تحویل بمانید.","pickupDescription":"نتیجه نهایی درخواست لغو سفارش پس از پیگیری پشتیبانی اسنپ‌فود به شما اطلاع داده می‌شود."},"refundDescription":"پس از تأیید درخواست توسط فروشگاه، {{totalValue}} تومان به کیف پول شما بازگشت داده خواهد شد."},"faqFeedBack":{"question":"این پاسخ برایتان مفید بود؟","like":"از اینکه این پاسخ به شما کمک کرد بسیار خوشحالیم.","dislike":"بازخوردتان ثبت شد و برای بهبود این پاسخ از آن کمک خواهیم گرفت.","suggestion":"این پاسخ چطور می‌توانست بهتر کمک کند؟","submit":"ثبت بازخورد","helpTextArea":"نظرتان باید بیشتر از ۱۰ حرف باشد.","placeHolderTextArea":"نظر خود را بنویسید"},"orderIssues":{"checkOrderStatus":"پیگیری وضعیت سفارش","someItemsAreMissing":"بعضی از اقلام سفارشم ارسال نشده یا اشتباه است","unsatisfiedFromQuality":"از کیفیت سفارشی که تحویل گرفته‌ام راضی نیستم","cancelOrder":"لغو سفارش","changeOrderDeliveryAddress":"تغییر آدرس تحویل سفارش","editOrder":"ویرایش سفارش","editOrderDescription":"اصلاح توضیحات سفارش","getPickupOrder":"می‌خواهم از درب فروشگاه تحویل بگیرم"},"failure":{"callToSnappExpress":" تماس با پشتیبانی اسنپ اکسپرس (سوپر مارکت)","chatSupport":"چت با پشتیبانی","chatSupportWithSnappfood":"چت با پشتیبانی اسنپ‌فود","contactSupport":"ارتباط با پشتیبانی","callSupport":"تماس با پشتیبانی","callSupportWithSnappfood":"تماس با پشتیبانی اسنپ‌فود","problemSolved":"مشکل پیش آمده برطرف نشد؟","user":"کاربر","dear":" عزیز ","chatDisabled":"غیرفعال","requestDetail":"مشاهده جزئیات درخواست","viewStatusRequest":"مشاهده وضعیت درخواست","dislikeFeedback":"بازخوردتان را ثبت کردیم و در بهبود این پاسخ استفاده می‌کنیم."},"pickupDeliverySubmit":{"header":"مراجعه حضوری","title":"می‌خواهم سفارش را درب فروشگاه تحویل بگیرم.","failurePickupTitle":"امکان تغییر روش تحویل وجود ندارد","failurePickupDescription":"برای سفارش شما پیک پیدا شد و امکان تغییر آن به مراجعه حضوری وجود ندارد.","submitSuccessWarning":"برای حرکت به سمت فروشگاه لطفاً منتظر اعلام نتیجه درخواست بمانید.","ticket":{"subtitle":"پشتیبانی اسنپ‌فود درخواست شما را از فروشگاه پیگیری می‌کند و در صورت تأیید می‌توانید پس از اتمام زمان آماده‌سازی به فروشگاه رفته و سفارش خود را تحویل بگیرید.","submit":"ثبت درخواست","modalQuestion":"آیا از درخواست خود اطمینان دارید؟","modalSubtitle":"در صورت تأیید کارشناس پیکی برای سفارش شما در نظر گرفته نمی‌شود.","successRequestTitle":"درخواست شما با موفقیت ثبت شد","successRequestSubtitle":"ما در پشتیبانی اسنپ‌فود درخواست شما را بررسی کرده و تا ۱۵ دقیقه دیگر نتیجه را به شما اعلام خواهیم کرد.","bannerDescription":"پس از تأیید درخواست توسط فروشگاه، {{price}} تومان هزینه پیک به کیف پول شما بازگشت داده خواهد شد."},"express":{"subtitle":"با زدن دکمه \xabتغییر روش تحویل\xbb، سفارش شما از ارسال با پیک به مراجعه حضوری تغییر می‌کند و می‌توانید پس از اتمام زمان آماده‌سازی به فروشگاه رفته و سفارش خود را تحویل بگیرید.","submit":"تغییر روش تحویل","modalQuestion":"آیا از تغییر روش تحویل اطمینان دارید؟","modalSubtitle":"با تغییر روش تحویل سفارش به مراجعه حضوری دیگر امکان ارسال با پیک وجود ندارد.","successRequestTitle":"سفارش شما با موفقیت به مراجعه حضوری تغییر کرد","successRequestSubtitle":"پس از اتمام زمان آماده‌سازی به محل فروشگاه مراجعه کرده و سفارش خود را تحویل بگیرید.","bannerDescription":"پس از تغییر به مراجعه حضوری فروشگاه، {{price}} تومان هزینه پیک به کیف پول شما بازگشت داده خواهد شد."}},"backToHome":"بازگشت به  صفحه اصلی","ticket":{"enter_problem_details":"لطفاً جزئیات مشکل را توضیح دهید","limit_character_description":"توضیحات باید بیشتر از ۱۰ حرف باشد."},"optional":"اختیاری","upload_image":"بارگذاری تصویر","upload_image_description":"بارگذاری تصویر روند پیگیری مشکل شما را آسان‌تر می‌کند.","submit_request":"ثبت درخواست","description":"توضیحات","transaction":"تراکنش","select_transaction":"انتخاب تراکنش","unSuccessful":"ناموفق","tooman":"تومانء","discrepancy":"مغایرت در سفارش","DiscrepancyInPackaging":"مغایرت در بسته‌بندی","yourPackaging":"بسته‌بندی سفارش شما","describeProblem":"لطفا مشکل پیش‌آمده را انتخاب کنید:","problemReport":"اعلام مشکل","requestProblemAndDescription":"توضیحات و ثبت درخواست","priceOfPackaging":"{{price}} تومان برای {{count}} پاکت","dissatisfaction":"نارضایتی از کیفیت سفارش","whichItemHadLowQuality":"کدام‌یک از اقلام سفارشتان کیفیت مناسبی نداشته است؟","whichItemSentWrong":"کدام‌یک از اقلام سفارشتان اشتباه ارسال شده است؟","quantity":"عدد","didntSendAtAll":"اصلاً ارسال نشده","continue":"ادامه","howManyDidNotSent":"چند عدد ارسال نشده است؟","didNotSendPackaging":"بسته‌بندی بهداشتی ارسال نشده","lessPackagingSent":"بسته‌بندی بهداشتی کمتر ارسال شده","packagingNotSendInformativeBannerText":"بعد از تایید پشتیبانی، {{price}} تومان بابت {{count}} پاکت به اعتبار شما بازگشت داده خواهد شد.","packagingPayBack":"{{price}} تومان بابت {{count}} پاکت به اعتبار شما بازگشت داده خواهد شد.","changeAddress":{"pageTitle":"تغییر آدرس سفارش","listTitle":"آدرس‌های قابل انتخاب","newAddress":"آدرس جدید","outsideAreaModal":{"title":"آدرس در محدوده نیست","description":"آدرس انتخاب‌شده در محدوده‌ سرویس‌دهی فروشگاه نیست.","edit":"ویرایش موقعیت"},"errorModal":{"title":"امکان ویرایش وجود ندارد","description":"یک پیک برای سفارش شما انتخاب شده و امکان ویرایش آدرس وجود ندارد."},"differencePriceModal":{"title":"مابه‌التفاوت هزینه ارسال","moreCashDescription":"در صورت تأیید درخواست شما توسط {{vendor}}، مابه‌التفاوت هزینه ارسال به هزینه سفارش شما اضافه می‌شود.","moreWalletDescription":"در صورت تأیید درخواست شما توسط {{vendor}}، مابه‌التفاوت هزینه ارسال از کیف‌ پولتان برداشت می‌شود.","lessWalletDescription":"در صورت تأیید درخواست شما توسط {{vendor}}، مابه‌التفاوت هزینه ارسال به کیف‌ پولتان واریز می‌شود.","lessCashDescription":"در صورت تأیید درخواست شما توسط {{vendor}}، مابه‌التفاوت هزینه ارسال از هزینه‌ سفارش شما کسر می‌گردد.","moreLinkDescription":"در صورت تأیید درخواست شما توسط {{vendor}}، لینکی برای پرداخت مابه‌التفاوت هزینه ارسال برای شما پیامک می‌شود.","banner":"برای جلوگیری از لغو شدن سفارش، پس از دریافت پیامک سریعا از طریق لینک ارسالی اقدام ب