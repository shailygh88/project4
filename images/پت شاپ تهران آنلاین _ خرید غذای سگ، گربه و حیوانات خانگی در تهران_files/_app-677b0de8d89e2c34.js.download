روس معتبر و به روز شده استفاده نمایید.","item-6":"رمز عبور خود را در فواصل زمانی کوتاه تغییر دهید.","item-7":"بانک و برنامه هرگز اطلاعات محرمانه شما را از طریق ایمیل درخواست نمی کنند، درصورت رخداد این مورد سریعأ به بانک اطلاع دهید"}},"acceptance":"کاربران می‌پذیرند و اعلام می‌کنند که کلیه موارد فوق الذکر را مطالعه کرده و مورد قبول ایشان است."}')},64050:(e,t,r)=>{"use strict";Object.defineProperty(t,"__esModule",{value:!0}),Object.defineProperty(t,"useMergedRef",{enumerable:!0,get:function(){return i}});let n=r(55729);function i(e,t){let r=(0,n.useRef)(null),i=(0,n.useRef)(null);return(0,n.useCallback)(n=>{if(null===n){let e=r.current;e&&(r.current=null,e());let t=i.current;t&&(i.current=null,t())}else e&&(r.current=o(e,n)),t&&(i.current=o(t,n))},[e,t])}function o(e,t){if("function"!=typeof e)return e.current=t,()=>{e.current=null};{let r=e(t);return"function"==typeof r?r:()=>e(null)}}("function"==typeof t.default||"object"==typeof t.default&&null!==t.default)&&void 0===t.default.__esModule&&(Object.defineProperty(t.default,"__esModule",{value:!0}),Object.assign(t.default,t),e.exports=t.default)},64255:(e,t,r)=>{"use strict";function n(e,t){return -1===t?e:2!==t}r.d(t,{L:()=>n})},64399:(e,t,r)=>{"use strict";r.d(t,{r:()=>n});let n=e=>{let{origin:t,delimiter:r,target:n}=e;if(!Number.isFinite(t))throw TypeError("origin must be a finite number");let i=String(t);return r&&n?`${i}${r}${n}`:i}},64418:(e,t,r)=>{"use strict";r.d(t,{a:()=>$});var n=r(43203),i=r(9518),o=r(74298),a=r(37585),s=r(69897),l=r(5596),c=r(82001),u=r(49308),d=r(98320),p=r(78472),f=r(18272);let h=()=>({slideDuration:300,fadeDuration:200}),m=e=>{let t=h();return"fade"===e?t.fadeDuration:t.slideDuration},g=(0,f.We)(["0%{top:100%;}100%{top:0;}"]),y=(0,f.We)(["0%{top:0;}100%{top:100%;}"]),v=(0,f.We)(["0%{opacity:0;}100%{opacity:1;}"]),b=(0,f.We)(["0%{opacity:1;}100%{opacity:0;}"]),_=(0,f.We)(["0%{transform:scale(95%);}100%{transform:scale(100%);}"]),E=(0,f.We)(["0%{transform:scale(100%);}100%{transform:scal